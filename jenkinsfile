pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_access= credentials('aws-access')
    }

    tools {
        maven 'maven'
    }

    stages {
        stage('checkout') {
            steps {
            git branch: 'master', url: 'https://github.com/vaishnavigulhane19/studentapp-ui.git'
            }

        }


        stage('Build') {
            steps {
                sh'''
                mvn clean package
                echo "build is successfull"
                '''
            }

            post {
                success {
                     archiveArtifacts artifacts: '**/target/*.war' ,fingerprint: true
                } 
            }
        }    

        stage('Artifacts to s3') {
            steps {
                sh '''
                aws s3 cp target/*.war s3://deploywithnavi.space/student.war
                '''
            }
        }    
    }
}
    